#include <stdio.h>
#define FILAS 6
#define COLUNAS 8

void ler_matriz(int m[FILAS][COLUNAS]){
    int i, j;
    for(i = 0; i < FILAS; i++){
        j = 0;
        while(j < COLUNAS){
            printf("Fila %d, cadeira %d (0 livre, 1 ocupada): ", i + 1, j + 1);
            scanf("%d", &m[i][j]);
            if(m[i][j] == 0 || m[i][j] == 1){
                j++;
            }
            else{
                printf("Valor inválido.\n");
            }
        }
    }
}

void exibir_matriz(int m[FILAS][COLUNAS]){
    int i, j;
    printf("Mapa de assentos\n");
    for(i = 0; i < FILAS; i++){
        for(j = 0; j < COLUNAS; j++){
            printf("%d ", m[i][j]);
        }
        printf("\n");
    }
}

void filas_livres(int m[FILAS][COLUNAS]){
    int i, j, todas, achou = 0;
    for(i = 0; i < FILAS; i++){
        todas = 1;
        for(j = 0; j < COLUNAS; j++){
            if(m[i][j] != 0){
                todas = 0;
            }
        }
        if(todas){
            if(!achou){
                printf("Filas totalmente livres:\n");
            }
            printf("%d\n", i + 1);
            achou = 1;
        }
    }
    if(!achou){
        printf("Não existe fila totalmente livre.\n");
    }
}

void filas_ocupadas(int m[FILAS][COLUNAS]){
    int i, j, todas, achou = 0;
    for(i = 0; i < FILAS; i++){
        todas = 1;
        for(j = 0; j < COLUNAS; j++){
            if(m[i][j] != 1){
                todas = 0;
            }
        }
        if(todas){
            if(!achou){
                printf("Filas totalmente ocupadas:\n");
            }
            printf("%d\n", i + 1);
            achou = 1;
        }
    }
    if(!achou){
        printf("Não existe fila totalmente ocupada.\n");
    }
}

void livres_por_fila(int m[FILAS][COLUNAS]){
    int i, j, livres;
    printf("Cadeiras livres por fila:\n");
    for(i = 0; i < FILAS; i++){
        livres = 0;
        for(j = 0; j < COLUNAS; j++){
            if(m[i][j] == 0){
                livres++;
            }
        }
        printf("Fila %d: %d\n", i + 1, livres);
    }
}

void colunas_ocupadas(int m[FILAS][COLUNAS]){
    int i, j, todas, achou = 0;
    for(j = 0; j < COLUNAS; j++){
        todas = 1;
        for(i = 0; i < FILAS; i++){
            if(m[i][j] != 1){
                todas = 0;
            }
        }
        if(todas){
            if(!achou){
                printf("Colunas totalmente ocupadas:\n");
            }
            printf("%d\n", j + 1);
            achou = 1;
        }
    }
    if(!achou){
        printf("Não existe coluna totalmente ocupada.\n");
    }
}

int main(){
    int mapa[FILAS][COLUNAS];

    ler_matriz(mapa);
    exibir_matriz(mapa);
    filas_livres(mapa);
    filas_ocupadas(mapa);
    livres_por_fila(mapa);
    colunas_ocupadas(mapa);

    return 0;
}